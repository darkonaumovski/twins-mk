# Sync server (Supabase). Copy to .env.production and fill in; see "Setting up the sync server" in the README.
# Both values are public by design (they ship inside the app). Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Push reminders (optional): public VAPID key from `npm run push:keys`.
VITE_VAPID_PUBLIC_KEY=
